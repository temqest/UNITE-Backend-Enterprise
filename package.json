{
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"fs.copyFileSync('src/server.js', 'dist/server.js'); fs.copyFileSync('src/index.js', 'dist/index.js')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/**/*.test.js",
    "setup:chat": "ts-node scripts/setup-chat.ts",
    "events:clear:plotted": "ts-node scripts/clear-plotted-events.ts",
    "seed:demo-org": "ts-node src/scripts/seed-demo-org-data.ts",
    "dedupe:coverage": "ts-node scripts/cleanup-demo-coverage-duplicates.ts",
    "debug:analytics-snapshot": "ts-node src/scripts/export-demo-org-analytics-snapshot.ts",
    "dev": "nodemon --watch src --ext js,ts,json --exec node src/server.js",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.5",
    "@types/nodemailer": "^6.4.15",
    "@types/sharp": "^0.31.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
